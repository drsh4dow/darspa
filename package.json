{
  "name": "darspa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run content && vp run documents && infisical run --env dev --path /cloudflare -- vp exec alchemy dev --profile darspa --stage local",
    "content": "vp exec node scripts/content.ts",
    "documents": "vp exec node scripts/documents.ts",
    "deploy:dev": "vp run build && infisical run --env dev --path /cloudflare -- vp exec alchemy deploy --profile darspa --stage dev",
    "deploy:prod": "vp run build && infisical run --env prod --path /cloudflare -- vp exec alchemy deploy --profile darspa --stage prod",
    "infra:plan:dev": "vp run build && infisical run --env dev --path /cloudflare -- vp exec alchemy plan --profile darspa --stage dev",
    "infra:plan:prod": "vp run build && infisical run --env prod --path /cloudflare -- vp exec alchemy plan --profile darspa --stage prod",
    "admin:grant": "vp exec node scripts/administrator.ts grant",
    "admin:revoke": "vp exec node scripts/administrator.ts revoke",
    "build": "vp run content && vp run documents && vp build",
    "prepare": "effect-tsgo patch --oxlint",
    "verify": "vp run content && vp run documents && vp check && vp exec tsc --noEmit -p server/tsconfig.json && vp test run && vp build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "^4.0.0-rc.117",
    "markdown-it": "15.0.2",
    "pdf-lib": "1.17.1",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rut.js": "2.1.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@cloudflare/workers-types": "5.20260927.1",
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/tsgo": "^0.46.1",
    "@hyzyla/pdfium": "2.1.13",
    "@napi-rs/canvas": "1.0.9",
    "@oxlint/plugins": "1.85.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "alchemy": "2.0.0-beta.79",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "miniflare": "4.20260730.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vite-plus": "1.0.0-rc.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "workerd": "1.20260928.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.2"
}
