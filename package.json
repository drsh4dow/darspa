{
  "name": "darspa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run content && infisical run --env dev --path /frontend -- vp exec convex dev --typecheck enable --start 'vp dev'",
    "content": "vp exec node scripts/content.ts",
    "dev:prepare": "vp run content && infisical run --env dev --path /frontend -- vp exec convex dev --once --typecheck enable --run development:seed",
    "deploy:dev": "vp run dev:prepare && infisical run --env dev --path /frontend -- vp exec static-hosting upload --dist dist/client --build-command 'vp run build'",
    "admin:grant": "vp exec node scripts/administrator.ts grant",
    "admin:revoke": "vp exec node scripts/administrator.ts revoke",
    "build": "vp run content && vp build",
    "prepare": "effect-tsgo patch --oxlint",
    "verify": "vp run content && vp check && vp test run && vp run build"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/react-query": "0.1.0",
    "@convex-dev/static-hosting": "0.2.1",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "effect": "^4.0.0-rc.117",
    "markdown-it": "15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/tsgo": "^0.46.1",
    "@oxlint/plugins": "1.85.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "0.0.60",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vite-plus": "1.0.0-rc.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@convex-dev/static-hosting@0.2.1": "patches/@convex-dev%2Fstatic-hosting@0.2.1.patch"
  }
}
