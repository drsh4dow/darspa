{
  "name": "darspa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --env dev --path /frontend -- vp exec convex dev --typecheck enable --start 'vp dev'",
    "dev:prepare": "infisical run --env dev --path /frontend -- vp exec convex dev --once --typecheck enable --run development:seed",
    "deploy:dev": "vp run dev:prepare && infisical run --env dev --path /frontend -- vp exec static-hosting upload --build-command 'vp run build'",
    "check": "vp check",
    "lint": "vp lint --max-warnings 0",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "build": "vp build",
    "verify": "vp run check && vp run typecheck && vp run test && vp run build"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "0.2.1",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "0.0.60",
    "oxlint": "1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.2"
}
