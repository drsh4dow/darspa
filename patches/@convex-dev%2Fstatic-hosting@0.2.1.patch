@@ -0,0 +1,32 @@
+import { setTimeout as delay } from "node:timers/promises";
+
+/** Retry gateway failures without restarting the entire staged deployment. */
+export async function uploadToStorage(
+  url: string,
+  content: Uint8Array<ArrayBuffer>,
+  contentType: string,
+): Promise<Response> {
+  const maxAttempts = 3;
+  for (let attempt = 1; ; attempt++) {
+    const response = await fetch(url, {
+      method: "POST",
+      headers: { "Content-Type": contentType },
+      body: content,
+    });
+    if (
+      response.status < 500 ||
+      response.status >= 600 ||
+      attempt === maxAttempts
+    ) {
+      return response;
+    }
+
+    // Release the failed response before reusing the upload URL and body.
+    // Never log the URL: its query string contains upload authorization.
+    await response.body?.cancel();
+    console.warn(
+      `Retrying storage upload after HTTP ${response.status} (attempt ${attempt + 1}/${maxAttempts}).`,
+    );
+    await delay(500 * 2 ** (attempt - 1));
+  }
+}
